{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HeavyCare",
  "version": "1.1.0",
  "identifier": "com.heavycare.desktop",
  "build": {
    "frontendDist": "../renderer/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HeavyCare",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "category": "Utility",
    "publisher": "HeavyCare",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
